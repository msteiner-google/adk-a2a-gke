# Terraform + provider version constraints.
#
# Pin the Google provider to a recent 6.x line; bump deliberately and re-test.

terraform {
  required_version = ">= 1.6"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}
